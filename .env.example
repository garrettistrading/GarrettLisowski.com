# Set these only in the hosting provider's encrypted environment settings.
# Without them, Sales Lab stays in explicitly labeled guided demo mode.
OPENAI_API_KEY=
# A private invitation code (at least 16 characters). Never expose it in source.
SALES_LAB_ACCESS_CODE=
# Random signing secret (at least 32 characters).
SALES_LAB_SESSION_SECRET=
# Optional model overrides
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
